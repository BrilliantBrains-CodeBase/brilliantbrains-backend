# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=production

# ── Database ──────────────────────────────────────────────────────────────────
# For production use a MongoDB Atlas URI with credentials:
# mongodb+srv://<user>:<password>@cluster.mongodb.net/brilliantbrains_db?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/brilliantbrains_db

# ── Auth / JWT ────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_64+_char_random_string
JWT_REFRESH_SECRET=replace_with_different_64+_char_random_string

# ── URLs ──────────────────────────────────────────────────────────────────────
# Used in password-reset emails — MUST match your deployed frontend domain
FRONTEND_URL=https://brilliantbrains.ai

# ── CORS ──────────────────────────────────────────────────────────────────────
DEV_ORIGINS=http://localhost:3000,http://localhost:5173
PROD_ORIGINS=https://brilliantbrains.digital,https://www.brilliantbrains.digital,https://brilliantbrains.ai,https://www.brilliantbrains.ai

# ── Super Admin Bootstrap ─────────────────────────────────────────────────────
# These are only used on first run to seed the super admin account.
# Change them immediately after the first deployment.
SUPERADMIN_EMAIL=admin@brilliantbrains.digital
SUPERADMIN_PASSWORD=ReplaceWithStrongPassword@123!
SUPERADMIN_NAME=BrilliantBrains Admin

# ── Email & SMTP ──────────────────────────────────────────────────────────────
# AES-256-CBC key for encrypting SMTP passwords at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# MUST be exactly 64 hex characters (32 bytes). Use a DIFFERENT key than dev.
EMAIL_ENCRYPTION_KEY=replace_with_64_char_hex_string

# ── Redis / BullMQ (optional) ─────────────────────────────────────────────────
# If omitted, emails send directly (no queue). Recommended for production.
# REDIS_URL=redis://localhost:6379
